                                                <ComboBoxItem Content="NP 7 3&quot;" Tag="NP 7 3&quot;"/>
                                                <ComboBoxItem Content="NP 7 2.5&quot;" Tag="NP 7 2.5&quot;"/>
                                                <ComboBoxItem Content="NP 9 4&quot;" Tag="NP 9 4&quot;"/>
                                                <ComboBoxItem Content="EXT TEL" Tag="EXT TEL"/>
                                                <ComboBoxItem Content="EXT 7 4&quot;" Tag="EXT 7 4&quot;"/>
                                                <ComboBoxItem Content="EXT 7 3&quot;" Tag="EXT 7 3&quot;"/>
                                                <ComboBoxItem Content="EXT 7 2.5&quot;" Tag="EXT 7 2.5&quot;"/>
                                                <ComboBoxItem Content="EXT 9 4&quot;" Tag="EXT 9 4&quot;"/>
                                            </ComboBox>

                                            <!-- Centerline Search Radius (Only enabled for Scope = Centerline) -->
                                            <TextBlock x:Name="LblReplaceRadius" Text="Centerline Search Radius (meters):" FontSize="10" FontWeight="Bold" Foreground="White" Margin="0,4,0,2" IsEnabled="False"/>
                                            <TextBox x:Name="TxtReplaceRadius" Text="10.0" Height="24" Margin="0,0,0,12" Background="#26262B" Foreground="White" BorderBrush="{StaticResource BorderBrush}" Padding="4,2,4,2" VerticalContentAlignment="Center" IsEnabled="False"/>

                                            <!-- Action Button -->
                                            <Button Content="REPLACE POLES" Style="{StaticResource AccentButtonStyle}" Click="BtnReplacePoles_Click" ToolTip="Mulai mengganti tiang pada model" Height="36"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- Subtab 2: PUBLISHING -->
                    <TabItem Header="PUBLISHING" Style="{StaticResource ModernTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Tag="Card_SmartLayoutDuplicator" Cursor="Hand" MouseDown="BtnToggleCard_Click" Background="Transparent" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Smart Layout Duplicator" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="▲" FontSize="10" Foreground="#A6ADC8" VerticalAlignment="Center" Grid.Column="1"/>
                                        </Grid>
                                        <StackPanel Margin="0,4,0,0">
                                            <!-- Source Layout Selection -->
                                            <TextBlock Text="Select Source Layout:" FontSize="10" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CboPubSourceLayout" Height="26" SelectedIndex="0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="↻" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Refresh layout list" Click="BtnRefreshLayouts_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                            </Grid>

                                            <!-- Preset Button -->
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,8,0,8" Background="#1D222B">
                                                <StackPanel>
                                                    <TextBlock Text="Quick Copy ABD FTTH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                                    <Button Content="Quick Copy (SCHEMATIC, MANCORE, FDT INFO)" Style="{StaticResource SecondaryButtonStyle}" Click="BtnPubQuickCopy_Click" Height="30" FontSize="10"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Manual Naming Settings -->
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8" Background="#1D222B">
                                                <StackPanel>
                                                    <TextBlock Text="Manual Naming Settings" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                                    
                                                    <!-- Use Prefix -->
                                                    <CheckBox x:Name="ChkPubUsePrefix" Content="Use Prefix" IsChecked="True" Foreground="White" Margin="0,4,0,2" Checked="ChkPubUsePrefix_Changed" Unchecked="ChkPubUsePrefix_Changed"/>
                                                    <TextBox x:Name="TxtPubPrefix" Text="ABD" Height="24" Margin="0,0,0,6" Background="#1E1E22" Foreground="White" BorderBrush="{StaticResource BorderBrush}" VerticalContentAlignment="Center" Padding="4,0,0,0"/>

                                                    <!-- Use Suffix -->
                                                    <CheckBox x:Name="ChkPubUseSuffix" Content="Use Suffix" IsChecked="False" Foreground="White" Margin="0,4,0,2" Checked="ChkPubUseSuffix_Changed" Unchecked="ChkPubUseSuffix_Changed"/>
                                                    <TextBox x:Name="TxtPubSuffix" Text="FDT" Height="24" Margin="0,0,0,6" Background="#1E1E22" Foreground="White" BorderBrush="{StaticResource BorderBrush}" VerticalContentAlignment="Center" Padding="4,0,0,0" IsEnabled="False"/>

                                                    <!-- Use Alphanumeric -->
                                                    <CheckBox x:Name="ChkPubUseAlpha" Content="Use Alphanumeric (A, B, C...)" IsChecked="False" Foreground="White" Margin="0,4,0,6"/>

                                                    <!-- Copy Count -->
                                                    <TextBlock Text="Copy Count:" FontSize="10" Foreground="White" Margin="0,4,0,2"/>
                                                    <TextBox x:Name="TxtPubCopyCount" Text="5" Height="24" Background="#1E1E22" Foreground="White" BorderBrush="{StaticResource BorderBrush}" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Execute Button -->
                                            <Button Content="DUPLICATE LAYERS" Style="{StaticResource AccentButtonStyle}" Click="BtnPubDuplicate_Click" Height="36" ToolTip="Duplikasi layout dengan penamaan pintar"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                
                                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid Tag="Card_SmartLayoutViewportAligner" Cursor="Hand" MouseDown="BtnToggleCard_Click" Background="Transparent" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Smart Layout Viewport Aligner" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="▲" FontSize="10" Foreground="#A6ADC8" VerticalAlignment="Center" Grid.Column="1"/>
                                        </Grid>
                                        <StackPanel Margin="0,4,0,0">
                                            <!-- Frame Detection Method -->
                                            <TextBlock Text="Frame Detection Method:" FontSize="10" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                                            <ComboBox x:Name="CboAlignMethod" Height="26" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="CboAlignMethod_SelectionChanged">
                                                <ComboBoxItem Content="Block Reference (Recommended)" Tag="BLOCK"/>
                                                <ComboBoxItem Content="Polyline &amp; Text Boundary" Tag="POLYLINE"/>
                                            </ComboBox>

                                            <!-- Block Name / Layer Filter -->
                                            <TextBlock x:Name="LblAlignBlockOrLayer" Text="Block Name Filter:" FontSize="10" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CboAlignBlockOrLayer" Height="26" SelectedIndex="0" VerticalAlignment="Center"/>
                                                <Button x:Name="BtnPickFrameTemplate" Grid.Column="1" Content="Select" Width="50" Height="26" Margin="4,0,0,0" ToolTip="Pick a template frame from drawing" Click="BtnPickFrameTemplate_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                            </Grid>

                                            <!-- Identifier Source -->
                                            <TextBlock x:Name="LblAlignIdSource" Text="Identifier Source:" FontSize="10" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                                            <ComboBox x:Name="CboAlignIdSource" Height="26" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="CboAlignIdSource_SelectionChanged">
                                                <ComboBoxItem Content="Attribute Value" Tag="ATTRIBUTE"/>
                                                <ComboBoxItem Content="Text Entity Inside Boundary" Tag="TEXT"/>
                                            </ComboBox>

                                            <!-- Attribute Tag Name -->
                                            <TextBlock x:Name="LblAlignIdTag" Text="Attribute Tag Name:" FontSize="10" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                                            <TextBox x:Name="TxtAlignIdTag" Text="SHEET_NO" Height="24" Margin="0,0,0,12" Background="#1E1E22" Foreground="White" BorderBrush="{StaticResource BorderBrush}" VerticalContentAlignment="Center" Padding="4,0,0,0"/>

                                            <!-- Execute Button -->
                                            <Button Content="ALIGN VIEWPORTS" Style="{StaticResource AccentButtonStyle}" Click="BtnAlignViewports_Click" Height="36" ToolTip="Align all viewport layouts to corresponding keymap frames"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>
</TabControl>

        <!-- Info / Logs (Row 2) -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,4,0,0">
            <StackPanel>
                <Grid Cursor="Hand" MouseDown="BtnToggleCard_Click" Background="Transparent" Tag="Card_StatusampReports" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Status &amp; Reports" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"  VerticalAlignment="Center"/>
                    <TextBlock Text="▲" FontSize="10" Foreground="#A6ADC8" VerticalAlignment="Center" Grid.Column="1"/>
                </Grid>
                <StackPanel Margin="0,4,0,0">
                <ScrollViewer Height="45" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtStatus" Text="Panel loaded. Ready to run." TextWrapping="Wrap" FontSize="11" Foreground="#A9A9B0"/>
                </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
