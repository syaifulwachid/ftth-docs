<UserControl x:Class="FTTHBasemap.UI.BasemapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="300"
             Background="#1E1E22" Foreground="#E0E0E6"
             FontFamily="Segoe UI, Inter, Roboto">

    <UserControl.Resources>
        <!-- Modern Color Scheme -->
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1C97EA" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A2A30" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E44" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9E9EAE" />
        <SolidColorBrush x:Key="RedAccentBrush" Color="#D9534F" />

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333339" />
            <Setter Property="Foreground" Value="#E0E0E6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E6" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Red Action Button Style -->
        <Style x:Key="RedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RedAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD2D2" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Green Action Button Style -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4CAF50" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox Custom Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,6" />
        </Style>

        <!-- Custom Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0E0E6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>

        <!-- ComboBox Styles for Dark Theme Visibility -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4,8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition MinWidth="24" Width="0" SharedSizeGroup="ComboBoxButton" />
                            </Grid.ColumnDefinitions>
                            
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="true"
                                   Grid.ColumnSpan="2"
                                   Placement="Bottom"
                                   Margin="1"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        Background="#2A2A30"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        Margin="0,2,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="true" VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="Grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="Canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                <Rectangle x:Name="OpaqueRect"
                                                           Fill="{Binding Background, ElementName=DropDownBorder}"
                                                           Height="{Binding ActualHeight, ElementName=DropDownBorder}"
                                                           Width="{Binding ActualWidth, ElementName=DropDownBorder}" />
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            
                            <ToggleButton Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="6"
                                                SnapsToDevicePixels="true">
                                            <Grid HorizontalAlignment="Right" Width="24">
                                                <Path x:Name="Arrow"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#E0E0E6"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="templateRoot" Property="Background" Value="#35353C" />
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#007ACC" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="true">
                                                <Setter TargetName="templateRoot" Property="Background" Value="#1E1E22" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <ContentPresenter IsHitTestVisible="false"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="PART_Popup" Property="IsOpen" Value="false" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#555555" />
                                <Setter Property="Background" Value="#1E1E22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A2A30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="6,4,6,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabControl Style -->
        <Style x:Key="ModernTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="#1E1E22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- TabItem Style with Custom ControlTemplate for Curved Folder Tabs -->
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}" Margin="12,6,12,6"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="#2A2A30" 
                                BorderBrush="#3E3E44" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="8,8,0,0" 
                                Margin="0,0,4,0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Selected Tab State -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="White" />
                                <Setter Property="Foreground" Value="#1E1E22" />
                                <Setter Property="Panel.ZIndex" Value="100"/>
                            </Trigger>
                            <!-- Unselected Mouse Over State -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#3E3E44"/>
                                <Setter Property="Foreground" Value="#E0E0E6"/>
                            </MultiTrigger>
                            <!-- Unselected Normal State -->
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#A9A9B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TabItem Style for Vertical Folder Tabs -->
        <Style x:Key="VerticalFolderTabItemStyle" TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" RenderTransformOrigin="0.5,0.5" FontSize="11" Margin="2,14,2,14">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="#20252F" 
                                BorderBrush="#2F3542" 
                                BorderThickness="1,1,0,1" 
                                CornerRadius="5,0,0,5" 
                                Margin="0,0,0,2"
                                Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite"
                                               ContentSource="Header"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Selected Tab State -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2D333F" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="1,1,0,1" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3D4554" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Panel.ZIndex" Value="100"/>
                            </Trigger>
                            <!-- Unselected Mouse Over State -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#2A2F3D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                            <!-- Unselected Normal State -->
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#8F96A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Custom Scrollbar Thumb Style -->
        <Style x:Key="ScrollThumbs" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid x:Name="Grid">
                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto" Fill="Transparent" />
                            <Border x:Name="Rectangle1" 
                                    CornerRadius="3" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch" 
                                    Width="Auto" 
                                    Height="Auto" 
                                    Background="#4F5566" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Rectangle1" Property="Background" Value="#6A7285" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="Rectangle1" Property="Background" Value="#007ACC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Border Background="Transparent" />
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="false" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="false" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbs}" Width="6" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid x:Name="Bg" SnapsToDevicePixels="true">
                                    <Border Background="Transparent" />
                                    <Track x:Name="PART_Track" IsEnabled="{TemplateBinding IsEnabled}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="false" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="false" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbs}" Height="6" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content Tabs -->
            <RowDefinition Height="Auto" /> <!-- Info / Logs -->
        </Grid.RowDefinitions>

        <!-- Header (Row 0) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FTTH Design Planner v3.6.9" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Built for FTTH Network Engineers – Native AutoCAD Engine v4.0" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- License Button -->
                    <Button x:Name="BtnLicense" Content="🔑" 
                            Width="20" Height="20" 
                            FontSize="10" FontWeight="Bold"
                            Foreground="#E0E0E6" Background="#333339" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Margin="4,0,0,0"
                            Click="BtnLicense_Click" ToolTip="Lisensi &amp; Aktivasi">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#44444C" />
                                        <Setter Property="Foreground" Value="#F1C40F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Info Button -->
                    <Button Content="ℹ" 
                            Width="20" Height="20" 
                            FontSize="10" FontWeight="Bold"
                            Foreground="#E0E0E6" Background="#333339" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Margin="4,0,0,0"
                            Click="BtnInfo_Click" ToolTip="Informasi Pembuat Software">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#44444C" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
            <Separator Background="{StaticResource BorderBrush}" Margin="0,8,0,0"/>

            <!-- License Notification Bar -->
            <Border x:Name="LicenseNotificationBar" Margin="0,8,0,0" Padding="8,6" CornerRadius="6" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLicenseWarningIcon" Text="⚠️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                    <TextBlock x:Name="TxtLicenseWarningMessage" Text="Lisensi akan berakhir dalam 2 hari." FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Tab Control (Row 1) -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Style="{StaticResource ModernTabControlStyle}" TabStripPlacement="Top" Margin="0,4,0,8">
            <!-- Tab 1: BASEMAP PREPARATION -->
            <TabItem Header="1. BASEMAP PREPARATION" Style="{StaticResource ModernTabItemStyle}">
                <TabControl TabStripPlacement="Top" Background="#2D333F" BorderThickness="0" Margin="0,8,0,0">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="#20252D"/>
                        </Style>
                    </TabControl.Resources>
                    
                    <!-- Subtab 1: MAP & BASEMAP -->
                    <TabItem Header="MAP &amp; BASEMAP" Style="{StaticResource ModernTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource CardStyle}">
                                 <StackPanel>
                                     <!-- Header Grid with Clickable Toggle -->
                                     <Grid Tag="Card_BoundaryAndMap" Cursor="Hand" MouseDown="BtnToggleCard_Click" Background="Transparent" Margin="0,0,0,4">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <TextBlock Text="Boundary &amp; Map Downloader" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                         <TextBlock x:Name="TxtToggleMapCardArrow" Grid.Column="1" Text="▼" FontSize="10" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                                     </Grid>
                                     
                                     <StackPanel x:Name="PanMapControls" Visibility="Collapsed" Margin="0,4,0,0">
                                          <Button x:Name="BtnImportKmlBoundary" Content="IMPORT KML/KMZ BOUNDARY" Style="{StaticResource AccentButtonStyle}" Height="32" Click="BtnImportKmlBoundary_Click" Margin="0,4,0,8" ToolTip="Import KML/KMZ Closed Polyline Boundary"/>
                                          <Separator Background="{StaticResource BorderBrush}" Margin="0,2,0,8"/>
                                         <!-- Row 1: Provider & Map Type -->
                                         <Grid Margin="0,0,0,8">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="8" />
                                                 <ColumnDefinition Width="*" />
                                             </Grid.ColumnDefinitions>
                                             <StackPanel Grid.Column="0">
                                                 <Label Content="Provider:" />
                                                 <ComboBox x:Name="CboMapProvider" Height="24" Background="#2A2A30" Foreground="White" BorderBrush="{StaticResource BorderBrush}" SelectedIndex="0" SelectionChanged="CboMapSettings_Changed">
                                                     <ComboBoxItem Content="Google" Tag="google"/>
                                                     <ComboBoxItem Content="Bing" Tag="bing"/>
                                                     <ComboBoxItem Content="ESRI" Tag="esri"/>
                                                 </ComboBox>
                                             </StackPanel>
                                             <StackPanel Grid.Column="2">
                                                 <Label Content="Map Type:" />
                                                 <ComboBox x:Name="CboMapType" Height="24" Background="#2A2A30" Foreground="White" BorderBrush="{StaticResource BorderBrush}" SelectedIndex="0">
                                                     <ComboBoxItem Content="Satellite" Tag="satellite"/>
                                                     <ComboBoxItem Content="Map (Roads)" Tag="map"/>
                                                     <ComboBoxItem Content="Hybrid" Tag="hybrid"/>
                                                 </ComboBox>
                                             </StackPanel>
                                         </Grid>

                                         <!-- Row 2: Resolution & Zoom Level -->
                                         <Grid Margin="0,0,0,8">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="8" />
                                                 <ColumnDefinition Width="*" />
                                             </Grid.ColumnDefinitions>
                                             <StackPanel Grid.Column="0">
                                                 <Label Content="Resolution:" />
                                                 <ComboBox x:Name="CboMapResolution" Height="24" Background="#2A2A30" Foreground="White" BorderBrush="{StaticResource BorderBrush}" SelectedIndex="0" SelectionChanged="CboMapResolution_SelectionChanged">
                                                     <ComboBoxItem Content="Manual Zoom" Tag="manual"/>
                                                     <ComboBoxItem Content="Normal (1 tile)" Tag="1"/>
                                                     <ComboBoxItem Content="Medium (4 tiles)" Tag="4"/>
                                                     <ComboBoxItem Content="High (16 tiles)" Tag="16"/>
                                                     <ComboBoxItem Content="Higher (64 tiles)" Tag="64"/>
