<Window x:Class="FTTHBasemap.UI.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktivasi Lisensi Software" Height="600" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        BorderThickness="0"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E22" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A2A30" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1C97EA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E44" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9E9EAE" />
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#E0E0E6" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2ECC71" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F39C12" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C" />

        <!-- Accent Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333339" />
            <Setter Property="Foreground" Value="#E0E0E6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44444C" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ComboBox Styles for Dark Theme Visibility -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition MinWidth="24" Width="0" SharedSizeGroup="ComboBoxButton" />
                            </Grid.ColumnDefinitions>
                            
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" Placement="Bottom" Margin="1" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder" Background="#1E1E22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=MainGrid}" Margin="0,2,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="true" VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="Grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="Canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                <Rectangle x:Name="OpaqueRect" Fill="{Binding Background, ElementName=DropDownBorder}" Height="{Binding ActualHeight, ElementName=DropDownBorder}" Width="{Binding ActualWidth, ElementName=DropDownBorder}" />
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            
                            <ToggleButton Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="true">
                                            <Grid HorizontalAlignment="Right" Width="24">
                                                <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#E0E0E6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="templateRoot" Property="Background" Value="#35353C" />
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#007ACC" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="true">
                                                <Setter TargetName="templateRoot" Property="Background" Value="#1E1E22" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <ContentPresenter IsHitTestVisible="false" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="PART_Popup" Property="IsOpen" Value="false" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#555555" />
                                <Setter Property="Background" Value="#1E1E22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E1E22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="6,4,6,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content (QRIS + Info) -->
                <RowDefinition Height="Auto" /> <!-- Manual Key Entry -->
                <RowDefinition Height="Auto" /> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔑" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="FTTH BASEMAP ACTIVATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Foreground="{StaticResource TextMutedBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"
                        FontSize="11" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content (QRIS Card) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- QRIS Title -->
                            <TextBlock Text="QRIS DINAMIS OTOMATIS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            
                            <!-- QR Code Container -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" Width="180" Height="180" CornerRadius="6" Padding="6">
                                <Grid>
                                    <Image x:Name="ImgQrCode" Width="168" Height="168" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock x:Name="TxtQrPlaceholder" Text="Memuat QRIS..." Foreground="#555555" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Merchant Name -->
                            <TextBlock Text="SWD SOFT DEVELOPER" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,8" FontWeight="SemiBold"/>

                            <!-- Amount -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock Text="Total Transfer: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="TxtAmount" Text="Rp 100.248" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="*Harus transfer nominal pas (presisi 3 digit terakhir)" FontSize="9" FontStyle="Italic" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <!-- Payment Code -->
                            <Border Background="#1E1E22" CornerRadius="4" Padding="6,4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Payment ID: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtPaymentId" Text="FTTH-248-ABC123" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <Button Content="📋" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0" Cursor="Hand" Click="BtnCopyPaymentId_Click" ToolTip="Salin Payment ID"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Request Activation Card -->
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Form Request Aktivasi Langganan:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            
                            <!-- Package Selector -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pilih Paket:" FontSize="10" Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboPackage" Grid.Column="1" Height="24" Background="#1E1E22" Foreground="White" BorderBrush="{StaticResource BorderBrush}" FontSize="10" VerticalContentAlignment="Center" SelectionChanged="CboPackage_SelectionChanged">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E22" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White" />
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="1 Bulan (TRIAL) (Rp 30.000)" IsSelected="True" Tag="1_trial"/>
                                    <ComboBoxItem Content="1 Bulan (Rp 100.000)" Tag="1"/>
                                    <ComboBoxItem Content="3 Bulan (Rp 270.000)" Tag="3"/>
                                    <ComboBoxItem Content="6 Bulan (Rp 500.000)" Tag="6"/>
                                    <ComboBoxItem Content="12 Bulan (Rp 900.000)" Tag="12"/>
                                </ComboBox>
                            </Grid>
                            
                            <!-- Telegram/WA Contact Input -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="No. WA / Telegram:" FontSize="10" Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBox x:Name="TxtTelegramContact" Height="24" Background="#1E1E22" Foreground="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4,2" FontSize="10" VerticalContentAlignment="Center" ToolTip="Contoh: 08123xxxx atau @username"/>
                                    <TextBlock Text="*Penting! Masukkan No WhatsApp atau Username Telegram Anda agar Admin dapat menghubungi jika ada kendala." FontSize="8" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Request Button -->
                            <Button x:Name="BtnRequestActivation" Content="Kirim Request Aktivasi ke Admin" Height="28" Style="{StaticResource AccentButtonStyle}" FontSize="10" Click="BtnRequestActivation_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Instruction Card -->
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Petunjuk Aktivasi:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="1. Pilih paket durasi langganan &amp; isi kontak WhatsApp/Telegram Anda di atas." FontSize="10" Foreground="{StaticResource TextWhiteBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="2. Klik 'Kirim Request Aktivasi ke Admin'." FontSize="10" Foreground="{StaticResource TextWhiteBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="3. Lakukan pembayaran dengan scan QRIS di atas (pastikan nominal pas)." FontSize="10" Foreground="{StaticResource TextWhiteBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="4. Admin memverifikasi dana masuk, program Anda akan langsung AKTIF otomatis!" FontSize="10" Foreground="{StaticResource TextWhiteBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Manual Key Entry -->
            <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock Text="Aktivasi Manual (Jika offline / punya Serial Key):" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtActivationKey" Grid.Column="0" Height="24" Background="#1E1E22" Foreground="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4,2" FontSize="10" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Aktifkan" Width="60" Height="24" Margin="6,0,0,0" Style="{StaticResource AccentButtonStyle}" FontSize="10" Click="BtnManualActivate_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Footer Actions -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Status Message -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Status: Menunggu Pembayaran Polling..." FontSize="10" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtDeviceId" Text="Device ID: Load..." FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Action Button -->
                <Button Grid.Column="1" Content="Batal / Tutup" Width="80" Height="26" Click="BtnClose_Click" Cursor="Hand" Style="{StaticResource SecondaryButtonStyle}" FontSize="10"/>
            </Grid>
        </Grid>
    </Border>
</Window>
